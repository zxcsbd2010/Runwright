{
  "name": "runwright-workbench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "test": "pnpm --filter @runwright/contracts build && pnpm --recursive test",
    "test:integration": "pnpm --filter @runwright/core exec vitest run --root ../.. --config vitest.integration.config.ts",
    "typecheck": "pnpm --recursive typecheck",
    "core:dev": "pnpm --filter @runwright/core dev",
    "core:start": "pnpm --filter @runwright/core start",
    "adapter:build": "pnpm --filter @runwright/next-adapter build"
  }
}
